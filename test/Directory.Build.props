<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- No unconditional PackageReferences here - xunit v2/v3 + AutoFixture selection differs by
       CluedIn target (see Packages.props), and must be conditioned on DefineConstants in each
       individual test csproj, not here. An unconditional xunit.v3 reference here plus a
       conditional xunit v2 reference in a non-V50 leg's csproj would put both xunit generations in
       the compile references at once -> CS0433 type clash. -->

</Project>